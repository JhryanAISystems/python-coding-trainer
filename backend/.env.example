# Database (SQLite by default; swap for a Postgres URL to scale up)
DATABASE_URL=sqlite:///./trainer.db

# CORS - the origin(s) the frontend is served from
FRONTEND_ORIGIN=http://localhost:5173

# Optional AI tutor mode. Leave unset to run fully offline on bundled exercises.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Sandbox limits for grading submitted code
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MEMORY_MB=128

# Rate limiting on the code execution endpoint
RATE_LIMIT_PER_MINUTE=30
